# Template for backend environment variables. Copy it and fill in real values:
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials, and never put them in this file.
# Every variable is optional: leave one out (or the whole file) and
# src/main/resources/application.yml falls back to the local Docker Postgres from
# `docker compose up -d`.
#
# Spring Boot does NOT read .env by itself. Load it into your shell before starting:
#
#   set -a; source .env; set +a
#   ./mvnw spring-boot:run
#
# (or paste the values into your IDE's run configuration). On Render, set them in the
# service's Environment tab instead.

# Keep the single quotes around values, so passwords containing $, & or spaces still load.

# Postgres connection in JDBC form. For Neon, copy the host and database from its
# connection string and keep ?sslmode=require. Default: jdbc:postgresql://localhost:5433/jack
SPRING_DATASOURCE_URL='jdbc:postgresql://your-host/your-database?sslmode=require'

# Database credentials. Default: jack / jack (the local Docker database only).
SPRING_DATASOURCE_USERNAME='your-username'
SPRING_DATASOURCE_PASSWORD='your-password'

# Set to "demo" to create the demo business and its sample data on startup.
# Leave it empty for a database with no demo account.
SPRING_PROFILES_ACTIVE='demo'

# HTTP port. Default: 4000. Render sets this automatically.
PORT='4000'
