# Template for backend environment variables. Copy it, then uncomment and fill in only
# the variables you need:
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials, and never put them in this file.
# Every variable is optional and every line below starts commented out, so an unedited
# copy changes nothing: src/main/resources/application.yml then falls back to the local
# Docker Postgres from `docker compose up -d`.
#
# Spring Boot does NOT read .env by itself. Load it into your shell before starting:
#
#   set -a; source .env; set +a
#   ./mvnw spring-boot:run
#
# Or paste the values into your IDE's run configuration, or on Render into the service's
# Environment tab. Those take values literally, so paste them exactly as written here,
# without quotes. Quotes are only for `source`: if a value contains $, &, spaces or other
# shell characters, wrap it in single quotes in .env (e.g. PASSWORD='p$ss&word').
# Neon's generated passwords don't need them.

# Postgres connection in JDBC form. For Neon, copy the host and database from its
# connection string and keep ?sslmode=require. Default: jdbc:postgresql://localhost:5433/jack
# SPRING_DATASOURCE_URL=jdbc:postgresql://your-host/your-database?sslmode=require

# Database credentials. Default: jack / jack (the local Docker database only).
# SPRING_DATASOURCE_USERNAME=your-username
# SPRING_DATASOURCE_PASSWORD=your-password

# Set to "demo" to create the demo business on startup.
# Leave it unset for a database with no demo account.
# SPRING_PROFILES_ACTIVE=demo

# HTTP port. Default: 4000. Render sets this automatically.
# PORT=4000

# Full HTTP(S) URL to the exchange-rate API endpoint base (the backend appends /USD).
# EXCHANGE_RATE_API_BASE_URL=https://open.er-api.com/v6/latest

# Use "fallback" to skip the live API and use only the bundled snapshot.
# EXCHANGE_RATES_SOURCE=live
# EXCHANGE_SUPPORTED_CURRENCIES=CAD,USD,EUR,GBP,AUD
