# Template for client (Vite) environment variables. Copy it to set values locally:
#
#   cp .env.example .env
#
# .env is gitignored. Vite reads these at build time (`npm run dev` / `npm run build`),
# so restart the dev server after changing them. Only VITE_-prefixed variables reach the
# browser, so never put secrets here.

# Optional. Shown on the Help page as "Still stuck? Email <address>."
# Leave it empty to show "Ask the person who set up this app for you." instead.
VITE_SUPPORT_EMAIL=
