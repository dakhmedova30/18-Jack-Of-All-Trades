# Copy this file to server/.env (which git ignores) and fill it in.
# On Render, set the same variables under Environment instead of using a file.

# Required. Any Postgres connection string: AWS RDS, Neon, Supabase, local, etc.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jack_of_all_trades

# Optional. disable | require | verify
# Default: disable for localhost, require (encrypted, certificate not checked) otherwise.
# DATABASE_SSL=require

# Optional. Fill an empty database with 24 sample items when the server starts.
# SEED_IF_EMPTY=true

# Optional. Defaults to 4000 locally; hosts like Render set it for you.
# PORT=4000

# Optional, for `npm test` only. The tests EMPTY every table in this database,
# so use a separate, throwaway database, never the demo one.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/jack_of_all_trades_test
